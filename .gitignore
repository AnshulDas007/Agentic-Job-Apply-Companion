# ============================================================
# Agentic-JobApply-Companion .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# --- Virtual Environment ---
venv/
.venv/
env/

# --- Data (selective tracking for stateless Actions runs) ---
# Ignore everything in data/ by default …
data/*
# … except the state files that Actions commits back:
!data/jobs_seen.json
!data/candidate_profile.json

# Logs
logs/

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# --- Playwright ---
playwright-report/
test-results/

# --- Agent working memory (local only, never committed) ---
PROGRESS_TRACKER.md
IMPLEMENTATION_PLAN.md
TASK_STATUS.md

# --- OS ---
Thumbs.db
ehthumbs.db

