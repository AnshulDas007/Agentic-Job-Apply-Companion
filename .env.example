# ============================================================
# Agentic-JobApply-Companion — Environment Variables
# ============================================================
# LOCAL USE:   Copy this file to .env and fill in your keys.
# GITHUB ACTIONS: Add secrets via Repo → Settings → Secrets
#                 and variables → Actions. Do NOT commit .env.
# ============================================================

# --- LLM Providers ---
# Groq (free tier: 14,400 req/day) — primary for parsing, classification, scoring
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio / Gemini (60 req/min free) — cover letters, legal review
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (optional, if you have free-tier credits)
OPENAI_API_KEY=your_openai_api_key_here

# --- Scraping ---
# Apify (free tier: $5 platform credit/month)
APIFY_TOKEN=your_apify_token_here

# --- GitHub ---
# GITHUB_TOKEN is auto-provided in GitHub Actions — no need to set it there.
# For local testing, create a personal access token with Issues read/write.
# GITHUB_TOKEN=your_github_pat_here
# GITHUB_REPOSITORY=AnshulDas007/Agentic-Job-Apply-Companion

# --- Application Settings ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Burn-in mode: true = hold ALL applications for review (first 2 weeks)
BURN_IN_MODE=true

# Match score threshold (0.0 to 1.0) — minimum relevance score to proceed
MATCH_SCORE_THRESHOLD=0.65
