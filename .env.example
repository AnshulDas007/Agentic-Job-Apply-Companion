# ============================================================
# Agentic-JobApply-Companion — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Providers ---
# Groq (free tier: 14,400 req/day) — primary for parsing, classification, scoring
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (free models available) — fallback for Groq rate limits
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio / Gemini (60 req/min free) — cover letters, legal review
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI (optional, if you have free-tier credits)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional, if you have free-tier credits)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Scraping ---
# Apify (free tier: $5 platform credit/month)
APIFY_TOKEN=your_apify_token_here

# --- Local LLM (optional) ---
# Ollama base URL (if running local models)
OLLAMA_BASE_URL=http://localhost:11434

# --- Application Settings ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Burn-in mode: true = hold ALL applications for review (first 2 weeks)
BURN_IN_MODE=true

# Match score threshold (0.0 to 1.0) — minimum relevance score to proceed
MATCH_SCORE_THRESHOLD=0.65

# --- Email Notifications (optional) ---
# SMTP settings for daily digest email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# DIGEST_RECIPIENT=your_email@gmail.com
